{
  "name": "scoreler-desktop",
  "version": "1.2.2",
  "private": true,
  "description": "Scoreler is a personal AI agent focused on studying.",
  "author": "Inno Agent Contributors",
  "type": "module",
  "workspaces": [
    "apps/inno-agent",
    "apps/inno-agent/web",
    "packages/scoreler-chatgpt"
  ],
  "main": "electron/entry.cjs",
  "scripts": {
    "build": "npm --workspace inno-agent run build && node scripts/scoreler-video-build.mjs && npm --workspace inno-agent-web run build",
    "start": "node scripts/scoreler-dev.mjs",
    "desktop": "npm run build && electron .",
    "test": "vitest run",
    "test:updater": "node --test scripts/source-updater.test.cjs",
    "update:check": "node scripts/source-updater.cjs check",
    "update:apply": "node scripts/source-updater.cjs apply",
    "package:win": "npm run build && node scripts/scoreler-package-win.mjs",
    "test:chatgpt-desktop": "npm --workspace inno-agent run build && npm --workspace inno-agent-web run build && electron scripts/verify-chatgpt-desktop.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.scoreler.desktop",
    "productName": "Scoreler",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "apps/inno-agent/dist/**/*",
      "apps/inno-agent/web/dist/**/*",
      "apps/inno-agent/presets/**/*",
      "apps/inno-agent/scripts/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "apps/inno-agent/video-dist/**/*",
      "apps/inno-agent/video/narrate.ps1",
      "!**/*.map",
      "!**/*.test.*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.sqlite",
      "!**/*.sqlite-wal",
      "!**/*.sqlite-shm",
      "!**/*.jsonl",
      "!**/.git/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "third-party-licenses/**/*",
      "scripts/source-updater.cjs",
      "scripts/desktop-updater.cjs",
      "source-update.json",
      "scripts/update-dependencies.cjs",
      "scripts/runtime-bootstrap.cjs",
      "scripts/brand-runtime.ps1",
      "packages/scoreler-chatgpt/src/**/*",
      "packages/scoreler-chatgpt/LICENSE",
      "packages/scoreler-chatgpt/README.md"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/node_modules/@homebridge/**/*",
      "**/node_modules/@injaneity/pi-computer-use/**/*",
      "apps/inno-agent/presets/**/*",
      "apps/inno-agent/scripts/**/*",
      "**/node_modules/@remotion/**/*",
      "apps/inno-agent/video-dist/**/*",
      "apps/inno-agent/video/narrate.ps1"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Scoreler"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/scoreler.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.535",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^30.0.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@larksuiteoapi/node-sdk": {
      "axios": "^1.16.1"
    },
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    },
    "xlsx": "$xlsx"
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "imapflow": "^2.5.8",
    "inno-agent": "^0.7.0",
    "mailparser": "^3.10.0",
    "@scoreler/chatgpt": "file:packages/scoreler-chatgpt"
  },
  "license": "MIT",
  "scorelerEdition": "without-free-models"
}
